          <button class="tier-action-btn" style="background: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border-glass);" disabled>
            CURRENT PLAN
          </button>
        </div>

        <!-- TIER 2: UPDATED TO 99 -->
        <div class="sub-card tier-green">
          <div>
            <div class="price-display-green">
              <span class="price-old">₹200</span>
              <span class="price-new-green">₹99<span class="lips-container">
                <svg class="lips-svg" viewBox="0 0 100 50" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 20 C 25 8, 40 14, 50 22 C 60 14, 75 8, 90 20" fill="#ff2d78" stroke="#ff0055" stroke-width="2"/>
                  <path id="lower-lip" d="M10 20 C 25 34, 40 30, 50 26 C 60 30, 75 34, 90 20" fill="#ff2d78" stroke="#ff0055" stroke-width="2"/>
                </svg>
              </span></span>
            </div>

            <ul class="bullet-points-list">
              <li><i class="fa-solid fa-fire" style="color: var(--neon-green);"></i> Hot pics</li>
              <li><i class="fa-solid fa-lemon" style="color: var(--neon-green);"></i> Daily melons</li>
              <li><i class="fa-solid fa-droplet" style="color: var(--neon-green);"></i> Wet pics</li>
            </ul>
          </div>
            <div style="margin-top: 12px;">
              <input type="text" id="phone-input" placeholder="Enter 10‑digit mobile number" style="padding: 14px; border-radius: 12px; border: 1px solid var(--neon-green); background: rgba(0, 255, 136, 0.05); color: #fff; width: 100%; text-align: center; font-size: 1rem; margin-bottom: 12px; box-shadow: 0 0 15px var(--neon-green-glow);" />
            </div>

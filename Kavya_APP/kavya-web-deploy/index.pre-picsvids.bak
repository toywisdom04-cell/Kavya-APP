    <!-- PAGE 3: PROFILE PAGE WITH DEFAULT "Normal User" TIER STATUS -->
    <section id="profile-section" class="page-section">
      <div class="profile-card">
        <div class="profile-dp-container">
          <img id="profile-dp-main" src="assets/person.jpeg" class="profile-dp-img" alt="Profile Picture">
          <label class="edit-dp-badge" title="Change DP">
            <i class="fa-solid fa-camera"></i>
            <input type="file" accept="image/*" style="display: none;" onchange="updateProfileDP(event)">
          </label>
        </div>

        <div>
          <input type="text" id="profile-username" class="profile-username-input" value="Kavya VIP User" onchange="saveProfileName(this.value)">
        </div>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Registered User Account</p>

        <div class="credits-stat-box">
          <div class="stat-item">
            <h3 id="profile-credits-num">21</h3>
            <p>Credits Remaining</p>
          </div>
          <div class="stat-item">
            <h3 id="profile-tier-status" style="font-size: 1.3rem;">Normal User</h3>
            <p>Tier Status</p>
          </div>
        </div>

        <button class="btn-neon-green" style="width: 100%;" onclick="navigateToSection('upgrade-section')">
          <i class="fa-solid fa-bolt"></i> GET MORE CREDITS / UPGRADE
        </button>

        <button class="btn-neon-red" style="width: 100%; margin-top: 16px;" onclick="handleDeleteAccount()" id="delete-account-btn">
          <i class="fa-solid fa-trash-can"></i> DELETE ACCOUNT
        </button>
      </div>
    </section>

    <!-- PAGE 4: SUBSCRIPTION & UPGRADE PAGE -->
    <section id="upgrade-section" class="page-section">
      <div class="sub-title-area">
        <h1>CHOOSE YOUR SUBSCRIPTION</h1>
        <p style="color: var(--text-muted); font-size: 1.1rem;">Unlock unlimited neon vibes, hot pics, and shower reels</p>
      </div>

      <div class="sub-cards-grid">
        <!-- TIER 1: FREE -->

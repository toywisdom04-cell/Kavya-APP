            <div class="btn-neon-gray">FREE</div>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Starter Tier</p>
            <ul class="bullet-points-list">
              <li><i class="fa-solid fa-check"></i> Chatting</li>
              <li><i class="fa-solid fa-check"></i> Explore</li>
            </ul>

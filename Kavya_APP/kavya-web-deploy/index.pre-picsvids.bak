    <!-- Menu-only business and legal information pages. Review with a qualified adviser before launch. -->
    <section id="about-section" class="page-section">
      <article class="legal-card">
        <h1>About Us</h1>
        <p>Kavya VIP is a digital-content platform where registered users can explore content and purchase optional credit packs.</p>
        <h2>Our service</h2>
        <p>We provide a web-based member experience, account access, and digital credit packs. Content and feature availability may change over time.</p>
        <h2>Our commitment</h2>
        <p>We aim to provide clear pricing, account controls, and responsive support for our users.</p>
      </article>
    </section>

    <section id="contact-section" class="page-section">
      <article class="legal-card">
        <h1>Contact Us</h1>
        <p>For account, billing, or technical support, contact us at <a href="mailto:REPLACE-WITH-YOUR-SUPPORT-EMAIL">REPLACE-WITH-YOUR-SUPPORT-EMAIL</a>.</p>
        <p>Please include the email address associated with your account and a short description of your request. Do not send passwords or payment-card details by email.</p>
      </article>
    </section>

    <section id="privacy-section" class="page-section">
      <article class="legal-card">
        <h1>Privacy Policy</h1>
        <p><strong>Last updated:</strong> July 28, 2026</p>
        <p>We collect account details such as email address, display name, account activity, and information needed to provide purchased credits. We use this information to operate the service, prevent misuse, and respond to support requests.</p>
        <p>Authentication and account data are processed through Supabase. Payment information is processed by the selected payment provider; we do not store full payment-card details in this website.</p>
        <p>We retain information only as needed to operate the service, meet legal obligations, resolve disputes, and enforce our agreements. To request access, correction, or deletion where applicable, contact the support address listed on the Contact Us page.</p>
      </article>
    </section>

    <section id="terms-section" class="page-section">
      <article class="legal-card">
        <h1>Terms &amp; Conditions</h1>
        <p>By using Kavya VIP, you agree to use the service lawfully and to keep your account credentials confidential. You must provide accurate account information and must not attempt to bypass access controls or interfere with the service.</p>
        <p>Credit packs provide access to digital features and are not cash, transferable currency, or an investment. Prices and available features may change before purchase.</p>
        <h2>Refunds and cancellations</h2>
        <p>Because credits are digital and may be used immediately, refund eligibility depends on applicable law and the circumstances of the purchase. Contact support promptly if you believe a payment was made in error.</p>
        <h2>Changes</h2>
        <p>We may update these terms when necessary. Continued use after an update means you accept the revised terms.</p>
      </article>
    </section>

  </main>

  <!-- Modal Lightbox -->
  <div class="modal-backdrop" id="media-modal" onclick="closeModal()">
    <div class="modal-content-box" onclick="event.stopPropagation()">
      <div class="modal-close-icon" onclick="closeModal()"><i class="fa-solid fa-xmark"></i></div>
      <div id="modal-media-content"></div>
      <div style="padding: 16px 20px; font-weight: 700; font-size: 1.1rem;" id="modal-title-element">Unlocked Media Preview</div>
    </div>
  </div>

  <div class="toast-container" id="toast-container"></div>

  <!-- JavaScript Engine -->
  <script>
    let mediaDatabase = JSON.parse(localStorage.getItem('kavya_cloud_media')) || [
      { id: 'item-1', title: 'Rain Shower Special', type: 'image', url: 'assets/person.jpeg', cost: 5 },
      { id: 'item-2', title: 'Hot Pics & Melons', type: 'image', url: 'assets/gallery_1.jpg', cost: 5 },
      { id: 'item-3', title: 'Romantic Expression', type: 'image', url: 'assets/gallery_2.jpg', cost: 10 },
      { id: 'item-4', title: 'Under Shower Reel 💋', type: 'video', url: 'assets/person.jpeg', cost: 15 }
    ];

    let state = {
      currentUser: JSON.parse(localStorage.getItem('kavya_session_user')) || null,
      unlockedCards: JSON.parse(localStorage.getItem('kavya_unlocked')) || []
    };

    function saveDatabases() {
      localStorage.setItem('kavya_cloud_media', JSON.stringify(mediaDatabase));
      localStorage.setItem('kavya_session_user', JSON.stringify(state.currentUser));
      localStorage.setItem('kavya_unlocked', JSON.stringify(state.unlockedCards));
    }

    /* Real-Time Central Sync Listener (Syncs Admin Uploads across APK & Web Tabs) */
    window.addEventListener('storage', () => {
      mediaDatabase = JSON.parse(localStorage.getItem('kavya_cloud_media')) || mediaDatabase;
      renderMediaGalleries();
    });

    window.addEventListener('DOMContentLoaded', () => {
      initAmbientCanvas();
      renderMediaGalleries();

      // Listen for Browser Back / Forward Button Navigation
      window.addEventListener('popstate', (e) => {
        if (e.state && e.state.section) {
          navigateToSection(e.state.section, false);
        } else {
          if (state.currentUser) {
            navigateToSection('home-section', false);
          } else {
            navigateToSection('signup-section', false);
          }
        }
      });

      if (state.currentUser) {
        applyUserSessionUI();
        const initialSection = location.hash ? location.hash.replace('#', '') : 'home-section';
        navigateToSection(initialSection, false);
      } else {
        document.getElementById('main-header').style.display = 'none';
        const initialPublicSection = location.hash ? location.hash.replace('#', '') : 'signup-section';
        navigateToSection(['about-section', 'contact-section', 'privacy-section', 'terms-section'].includes(initialPublicSection) ? initialPublicSection : 'signup-section', false);
      }

      // 3D Parallax Effect
      const card3D = document.getElementById('signup-card-3d');
      if (card3D) {
        document.addEventListener('mousemove', (e) => {
          if (!document.getElementById('signup-section').classList.contains('active')) return;
          const xAxis = (window.innerWidth / 2 - e.pageX) / 25;
          const yAxis = (window.innerHeight / 2 - e.pageY) / 25;
          card3D.style.transform = `rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;
        });
      }
    });

    function toggleCaptcha() {
      const check = document.getElementById('captcha-check');
      check.checked = !check.checked;
    }

    function applyUserSessionUI() {
      if (!state.currentUser) return;

      document.getElementById('main-header').style.display = 'flex';
      const user = state.currentUser;

      document.getElementById('credits-amount-display').innerText = user.credits;
      document.getElementById('drawer-credits-display').innerText = `⚡ ${user.credits} Credits`;
      document.getElementById('profile-credits-num').innerText = user.credits;

      document.getElementById('profile-username').value = user.username;
      document.getElementById('drawer-username-display').innerText = user.username;
      document.getElementById('profile-tier-status').innerText = user.tierStatus || 'Normal User';

      if (user.dp) {
        document.getElementById('nav-avatar-img').src = user.dp;
        document.getElementById('profile-dp-main').src = user.dp;
        document.getElementById('drawer-avatar-img').src = user.dp;
      }
    }

    /* Navigation & Browser Back Button History */
    const navItems = document.querySelectorAll('.nav-item');
    navItems.forEach(item => {
      item.addEventListener('click', () => {
        const target = item.getAttribute('data-target');
        navigateToSection(target);
        closeSidebar();
      });
    });

    function navigateToSection(sectionId, pushHistory = true) {
      const publicSections = ['signup-section', 'about-section', 'contact-section', 'privacy-section', 'terms-section'];
      if (!state.currentUser && !publicSections.includes(sectionId)) {
        showToast('Please sign in to access content.', 'error');
        sectionId = 'signup-section';
      }

      document.querySelectorAll('.page-section').forEach(sec => sec.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));

      const targetSec = document.getElementById(sectionId);
      if (targetSec) targetSec.classList.add('active');

      const activeNavItem = document.querySelector(`.nav-item[data-target="${sectionId}"]`);
      if (activeNavItem) activeNavItem.classList.add('active');

      if (pushHistory) {
        history.pushState({ section: sectionId }, '', '#' + sectionId);
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    const sidebarOverlay = document.getElementById('sidebar-overlay');
    document.getElementById('open-menu-btn').addEventListener('click', () => sidebarOverlay.classList.add('active'));
    document.getElementById('close-menu-btn').addEventListener('click', closeSidebar);
    sidebarOverlay.addEventListener('click', (e) => {
      if (e.target === sidebarOverlay) closeSidebar();
    });

    function closeSidebar() {
      sidebarOverlay.classList.remove('active');
    }

    document.getElementById('nav-profile-btn').addEventListener('click', () => navigateToSection('profile-section'));
    document.getElementById('drawer-profile-btn').addEventListener('click', () => {
      navigateToSection('profile-section');
      closeSidebar();
    });
    document.getElementById('nav-credits-btn').addEventListener('click', () => navigateToSection('upgrade-section'));

    /* Render Dynamic Media Galleries */
    function renderMediaGalleries() {
      const homeGrid = document.getElementById('home-media-grid');
      const imgGrid = document.getElementById('images-media-grid');
      const vidGrid = document.getElementById('videos-media-grid');

      if (!homeGrid || !imgGrid || !vidGrid) return;

      homeGrid.innerHTML = '';
      imgGrid.innerHTML = '';
      vidGrid.innerHTML = '';

      mediaDatabase.forEach(item => {
        const isUnlocked = state.unlockedCards.includes(item.id);
                const cardHTML = `
          <div class="media-card ${isUnlocked ? 'unlocked' : ''}" id="${item.id}" data-media-id="${item.id}">
            <div class="media-thumb" onclick="${isUnlocked ? `openModal('${item.url}', '${item.title}', '${item.type}')` : `unlockMedia('${item.id}', ${item.cost})`}">
              ${item.type === 'video'
                ? `<video src="${item.url}" preload="metadata" muted playsinline></video>`
                : `<img src="${item.url}" alt="${item.title}">`}
              <div class="media-overlay-lock">
                <div class="lock-icon-neon"><i class="fa-solid ${item.type === 'video' ? 'fa-play' : 'fa-lock'}"></i></div>
                <button class="unlock-btn">Unlock (${item.cost} Credits)</button>
              </div>
            </div>
            <div class="media-info">
              <div class="media-title">${item.title}</div>
              <div class="media-cost">⚡ ${item.cost} Credits</div>
            </div>
            <div class="media-actions">
              <button type="button" class="media-action-btn like-btn${myLikedMediaIds.has(item.id) ? ' liked' : ''}" data-media-id="${item.id}" onclick="toggleMediaLike(this)">
                <i class="fa-solid fa-heart"></i> <span class="like-count">${mediaLikeCounts[item.id] || 0}</span>
              </button>
              <button type="button" class="media-action-btn comment-btn" data-media-id="${item.id}" onclick="toggleComments(this)">
                <i class="fa-solid fa-comment"></i> <span class="comment-count">${mediaCommentCounts[item.id] || 0}</span>
              </button>
              <button type="button" class="media-action-btn share-btn" data-media-id="${item.id}" onclick="shareMedia(this)">
                <i class="fa-solid fa-share-nodes"></i>
              </button>
            </div>
            <div class="media-comments-box">
              <div class="comments-list"></div>
              <div class="comment-input-row">
                <input type="text" class="comment-input" data-media-id="${item.id}" placeholder="Write a lovely comment... 💋" />
                <button type="button" class="comment-submit-btn" data-media-id="${item.id}" onclick="addComment(this)">Post</button>
              </div>
            </div>
          </div>
        `;

        homeGrid.insertAdjacentHTML('beforeend', cardHTML);
        if (item.type === 'image') {
          imgGrid.insertAdjacentHTML('beforeend', cardHTML);
        } else {
          vidGrid.insertAdjacentHTML('beforeend', cardHTML);
        }
      });
    }

        async function unlockMedia(cardId, cost) {
      if (!state.currentUser) return showToast('Please sign in to unlock media.', 'error');

      try {
        const { data, error } = await supabaseClient.rpc('unlock_media_for_current_user', { p_media_id: cardId });

        if (error) throw new Error(error.message);
        if (data.status === 'error') throw new Error(data.message);

        if (data.status === 'unlocked' || data.status === 'already_unlocked') {
          // Update local state and UI
          state.currentUser.credits = data.credits_balance;
          if (!state.unlockedCards.includes(cardId)) {
            state.unlockedCards.push(cardId);
          }
          saveDatabases();
          applyUserSessionUI();
          renderMediaGalleries();

          if(data.status === 'unlocked') {
            showToast(`Unlocked! Deducted ${cost} credits.`);
          }

          const item = mediaDatabase.find(i => i.id === cardId);
          if (item) openModal(item.url, item.title, item.type);

        } else if (data.status === 'INSUFFICIENT_CREDITS') {
          showToast('Not enough credits! Please Upgrade.', 'error');
          navigateToSection('upgrade-section');
        } else {
          throw new Error('An unknown error occurred.');
        }
      } catch (err) {
        console.error('Unlock media error:', err);
        showToast(err.message || 'Could not unlock media. Please try again.', 'error');
      }
    }

        async function buySubscription(planId) {
      if (!state.currentUser) return showToast('Please sign in before purchasing credits.', 'error');

      if (planId !== 'pro_99' && planId !== 'vip_179') {
        return showToast('This credit pack is unavailable.', 'error');
      }

        const phoneInputId = planId === 'pro_99' ? 'phone-input' : 'phone-input-vip';
        const phoneInput = document.getElementById(phoneInputId);
        if (!phoneInput) return showToast('Phone input not found.', 'error');

        const phone = phoneInput.value.trim();
        if (!phone) return showToast('Please enter your mobile number.', 'error');
        const customerPhone = phone.replace(/\D/g, '');
        if (!/^\d{10}$/.test(customerPhone)) return showToast('Enter a valid 10‑digit mobile number.', 'error');

      try {
        const { data: { session }, error: sessionError } = await supabaseClient.auth.getSession();
        if (sessionError || !session?.access_token) {
          throw new Error('Your sign-in session has expired. Please sign out and sign in again.');
        }

        const { data, error } = await supabaseClient.functions.invoke('cashfree-create-order', {
          body: { planId, customerPhone },
          headers: { Authorization: `Bearer ${session.access_token}` }
        });

        if (error) throw error;
        if (!data?.paymentSessionId || !data?.environment) throw new Error('Payment session could not be created.');
        if (typeof Cashfree !== 'function') throw new Error('Cashfree checkout could not be loaded.');

        const cashfree = Cashfree({ mode: data.environment });
        const result = await cashfree.checkout({ paymentSessionId: data.paymentSessionId, redirectTarget: '_modal' });
        if (result?.error) throw new Error(result.error.message || 'Cashfree checkout could not open.');
        showToast('Payment submitted. Credits are added when Cashfree confirms it.');
      } catch (error) {
        console.error('Cashfree checkout error:', error);
        let message = error.message || 'Could not start payment. Please try again.';
        try {
          const body = await error.context?.text();
          if (body) {
            const parsed = JSON.parse(body);
            if (parsed?.error) message = parsed.error;
          }
        } catch (_) {}
        showToast(message, 'error');
      }
    }

    function updateProfileDP(e) {
      const file = e.target.files[0];
      if (file && state.currentUser) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          state.currentUser.dp = evt.target.result;
          saveDatabases();
          applyUserSessionUI();
          showToast('Profile picture updated successfully!');
        };
        reader.readAsDataURL(file);
      }
    }

    function saveProfileName(val) {
      if (state.currentUser) {
        state.currentUser.username = val;
        saveDatabases();
        applyUserSessionUI();
        showToast('Username updated!');
      }
    }

    function openModal(url, title, type) {
      const contentEl = document.getElementById('modal-media-content');
      if (type === 'video') {
        contentEl.innerHTML = `<video src="${url}" class="modal-img" controls controlsList="nodownload noplaybackrate" disablePictureInPicture autoplay draggable="false"></video>`;
      } else {
        contentEl.innerHTML = `<img src="${url}" class="modal-img" alt="${title}" draggable="false">`;
      }
      document.getElementById('modal-title-element').innerText = title;
      document.getElementById('media-modal').classList.add('active');
    }

    function closeModal() {
      document.getElementById('media-modal').classList.remove('active');
    }

    async function sendChatMessage() {
      const input = document.getElementById('chat-input-msg');
      const text = input.value.trim();
      if (!text || !state.currentUser) return;

      try {
        const { data: success, error } = await supabaseClient.rpc('deduct_chat_credit');
        if (error) throw new Error(error.message);

        if (!success) {
          showToast('You need at least 1 credit to send messages.', 'error');
          navigateToSection('upgrade-section');
          return;
        }

        // Visually update credits immediately
        state.currentUser.credits -= 1;
        applyUserSessionUI();
        saveDatabases();

        const msgsArea = document.getElementById('chat-messages');
        const userBubble = document.createElement('div');
        userBubble.className = 'msg-bubble user';
        userBubble.innerText = text;
        msgsArea.appendChild(userBubble);

        input.value = '';
        msgsArea.scrollTop = msgsArea.scrollHeight;

        setTimeout(() => {
          const botResponses = [
            "Mmm, I love that! Tells me more... 💋",
            "You're making my heart beat faster! Want to unlock my shower reel?",
            "That's so sweet of you! Check out my new hot pics in the gallery 💖",
            "I'm all yours today! What should we explore next?"
          ];
          const randomResp = botResponses[Math.floor(Math.random() * botResponses.length)];

          const botBubble = document.createElement('div');
          botBubble.className = 'msg-bubble bot';
          botBubble.innerText = randomResp;
          msgsArea.appendChild(botBubble);
          msgsArea.scrollTop = msgsArea.scrollHeight;
        }, 1000);

      } catch (err) {
        console.error('Chat error:', err);
        showToast(err.message || 'Could not send message.', 'error');
      }
    }

    function showMediaViewer(itemId) {
      const item = mediaDatabase.find(i => i.id === itemId);
      if (!item) return;

      const viewer = document.getElementById('media-viewer');
      const content = document.getElementById('media-viewer-content');
      
      let mediaHTML = '';
      if (item.type === 'video') {
        // For video, create a video element with controls
        mediaHTML = `
          <video controls autoplay style="max-width: 90vw; max-height: 80vh; border-radius: 12px;">
            <source src="${item.url}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        `;
      } else {
        // For image, create an img element
        mediaHTML = `<img src="${item.url}" style="max-width: 90vw; max-height: 80vh; border-radius: 12px;" alt="${item.title}">`;
      }

      content.innerHTML = `
        <h2 style="font-size: 1.6rem; margin-bottom: 20px; color: var(--neon-cyan);">${item.title}</h2>
        ${mediaHTML}
        <button class="viewer-close-btn" onclick="closeMediaViewer()"><i class="fa-solid fa-times"></i></button>
      `;
      
      viewer.classList.add('active');
    }

    function showToast(msg, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast-msg';
      toast.style.borderColor = type === 'error' ? 'var(--neon-red)' : 'var(--neon-green)';
      toast.innerHTML = `<i class="fa-solid ${type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check'}" style="color: ${type === 'error' ? 'var(--neon-red)' : 'var(--neon-green)'}"></i> ${msg}`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function initAmbientCanvas() {
      const canvas = document.getElementById('ambient-canvas');
      const ctx = canvas.getContext('2d');
      function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
      resize(); window.addEventListener('resize', resize);
      const drops = [];
      for (let i = 0; i < 60; i++) {
        drops.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, length: Math.random() * 20 + 10, speed: Math.random() * 8 + 4, color: Math.random() > 0.5 ? 'rgba(0, 240, 255, 0.4)' : 'rgba(255, 0, 85, 0.4)' });
      }
      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        drops.forEach(d => {
          ctx.beginPath(); ctx.moveTo(d.x, d.y); ctx.lineTo(d.x, d.y + d.length); ctx.strokeStyle = d.color; ctx.lineWidth = 1.5; ctx.stroke();
          d.y += d.speed; if (d.y > canvas.height) { d.y = -d.length; d.x = Math.random() * canvas.width; }
        });
        requestAnimationFrame(draw);
      }
      draw();
    }

    // Disable browser media context menus and drag actions.
    document.addEventListener('contextmenu', function(e) {
      if (e.target.closest('.media-thumb, #modal-media-content, #media-modal')) {
        e.preventDefault();
      }
    });

    document.addEventListener('dragstart', function(e) {
      if (e.target.closest('.media-thumb, #modal-media-content, #media-modal')) {
        e.preventDefault();
      }
    });
  </script>
  <script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    // This key is intentionally public; database and Storage policies in supabase/schema.sql enforce access.
    const supabaseClient = window.supabase.createClient(
      'https://lvxhfhsizlpvvwwjpsmb.supabase.co',
      'sb_publishable_9D55Dak0M5bGUOH0jPVmQQ_gbRAWmSi'
    );

    function cloudMedia(row) {
      return {
        id: row.id, title: row.title, type: row.media_type, cost: row.credit_cost,
        url: supabaseClient.storage.from('media').getPublicUrl(row.storage_path).data.publicUrl
      };
    }

    async function loadCloudMedia() {
      const { data, error } = await supabaseClient.from('media').select('*').order('created_at', { ascending: false });
      if (error) { console.error(error); showToast('Could not load cloud media.', 'error'); return; }
      mediaDatabase = data.map(cloudMedia);
      renderMediaGalleries();
    }

        async function loadCloudProfile(user) {
      const { data: profileData, error: profileError } = await supabaseClient.from('profiles').select('*').eq('id', user.id).single();
      if (profileError) throw profileError;

      const { data: unlockData, error: unlockError } = await supabaseClient.from('user_media_unlocks').select('media_id').eq('user_id', user.id);
      if (unlockError) throw unlockError;

      state.currentUser = {
        id: profileData.id, email: profileData.email, username: profileData.username, credits: profileData.credits,
        tierStatus: profileData.tier_status, dp: profileData.avatar_url || 'assets/person.jpeg'
      };
      state.unlockedCards = unlockData.map(u => u.media_id);

      localStorage.setItem('kavya_session_user', JSON.stringify(state.currentUser));
      localStorage.setItem('kavya_unlocked', JSON.stringify(state.unlockedCards));
    }

    let mediaLikeCounts = {};
    let mediaCommentCounts = {};
    let mediaComments = {};
    let commentLikeCounts = {};
    let myLikedMediaIds = new Set();
    let myLikedCommentIds = new Set();

    function escapeHtml(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    async function loadMediaInteractions() {
      try {
        const [likesRes, commentsRes, commentLikesRes, myLikes, myCommentLikes] = await Promise.all([
          supabaseClient.from('media_likes').select('media_id'),
          supabaseClient.from('media_comments').select('*').order('created_at', { ascending: true }),
          supabaseClient.from('comment_likes').select('comment_id'),
          state.currentUser ? supabaseClient.from('media_likes').select('media_id').eq('user_id', state.currentUser.id) : Promise.resolve({ data: [] }),
          state.currentUser ? supabaseClient.from('comment_likes').select('comment_id').eq('user_id', state.currentUser.id) : Promise.resolve({ data: [] })
        ]);
        if (likesRes.error) throw likesRes.error;
        if (commentsRes.error) throw commentsRes.error;
        if (commentLikesRes.error) throw commentLikesRes.error;
        mediaLikeCounts = {};
        (likesRes.data || []).forEach(r => { mediaLikeCounts[r.media_id] = (mediaLikeCounts[r.media_id] || 0) + 1; });
        mediaComments = {};
        mediaCommentCounts = {};
        (commentsRes.data || []).forEach(c => {
          if (!mediaComments[c.media_id]) mediaComments[c.media_id] = [];
          mediaComments[c.media_id].push(c);
          mediaCommentCounts[c.media_id] = (mediaCommentCounts[c.media_id] || 0) + 1;
        });
        commentLikeCounts = {};
        (commentLikesRes.data || []).forEach(r => { commentLikeCounts[r.comment_id] = (commentLikeCounts[r.comment_id] || 0) + 1; });
        myLikedMediaIds = new Set((myLikes.data || []).map(r => r.media_id));
        myLikedCommentIds = new Set((myCommentLikes.data || []).map(r => r.comment_id));
        renderMediaGalleries();
      } catch (e) {
        console.error('loadMediaInteractions error:', e);
      }
    }

    function updateLikeButtons(mediaId) {
      document.querySelectorAll('.like-btn[data-media-id="' + mediaId + '"]').forEach(b => {
        const span = b.querySelector('.like-count');
        if (span) span.textContent = mediaLikeCounts[mediaId] || 0;
        b.classList.toggle('liked', myLikedMediaIds.has(mediaId));
      });
      document.querySelectorAll('.comment-btn[data-media-id="' + mediaId + '"]').forEach(b => {
        const span = b.querySelector('.comment-count');
        if (span) span.textContent = mediaCommentCounts[mediaId] || 0;
      });
    }

    function flyKisses(btn) {
      const rect = btn.getBoundingClientRect();
      const emojis = ['💋', '💕', '❤️', '😘', '💖'];
      for (let i = 0; i < 7; i++) {
        const s = document.createElement('span');
        s.className = 'kiss-float';
        s.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        s.style.left = (rect.left + Math.random() * rect.width) + 'px';
        s.style.top = (rect.top + Math.random() * 10) + 'px';
        document.body.appendChild(s);
        setTimeout(() => s.remove(), 1500);
      }
    }

    async function toggleMediaLike(btn) {
      if (!state.currentUser) { showToast('Please sign in to like.', 'error'); navigateToSection('signup-section'); return; }
      const mediaId = btn.getAttribute('data-media-id');
      const liked = myLikedMediaIds.has(mediaId);
      try {
        if (liked) {
          const { error } = await supabaseClient.from('media_likes').delete().eq('user_id', state.currentUser.id).eq('media_id', mediaId);
          if (error) throw error;
          myLikedMediaIds.delete(mediaId);
          mediaLikeCounts[mediaId] = Math.max(0, (mediaLikeCounts[mediaId] || 1) - 1);
        } else {
          const { error } = await supabaseClient.from('media_likes').insert({ user_id: state.currentUser.id, media_id: mediaId });
          if (error) throw error;
          myLikedMediaIds.add(mediaId);
          mediaLikeCounts[mediaId] = (mediaLikeCounts[mediaId] || 0) + 1;
          flyKisses(btn);
        }
        updateLikeButtons(mediaId);
      } catch (e) {
        console.error('toggleMediaLike error:', e);
        showToast(e.message || 'Could not update like.', 'error');
      }
    }

    async function toggleCommentLike(btn) {
      if (!state.currentUser) { showToast('Please sign in to like comments.', 'error'); navigateToSection('signup-section'); return; }
      const commentId = btn.getAttribute('data-comment-id');
      const liked = myLikedCommentIds.has(commentId);
      try {
        if (liked) {
          const { error } = await supabaseClient.from('comment_likes').delete().eq('user_id', state.currentUser.id).eq('comment_id', commentId);
          if (error) throw error;
          myLikedCommentIds.delete(commentId);
          commentLikeCounts[commentId] = Math.max(0, (commentLikeCounts[commentId] || 1) - 1);
        } else {
          const { error } = await supabaseClient.from('comment_likes').insert({ user_id: state.currentUser.id, comment_id: commentId });
          if (error) throw error;
          myLikedCommentIds.add(commentId);
          commentLikeCounts[commentId] = (commentLikeCounts[commentId] || 0) + 1;
          flyKisses(btn);
        }
        btn.classList.toggle('liked', myLikedCommentIds.has(commentId));
        const span = btn.querySelector('.comment-like-count');
        if (span) span.textContent = commentLikeCounts[commentId] || 0;
      } catch (e) {
        console.error('toggleCommentLike error:', e);
        showToast(e.message || 'Could not update like.', 'error');
      }
    }

    function toggleComments(btn) {
      const card = btn.closest('.media-card');
      if (!card) return;
      const box = card.querySelector('.media-comments-box');
      if (!box) return;
      const open = box.style.display === 'block';
      box.style.display = open ? 'none' : 'block';
      if (!open) renderComments(card, btn.getAttribute('data-media-id'));
    }

    function renderComments(card, mediaId) {
      const list = card.querySelector('.comments-list');
      if (!list) return;
      const comments = mediaComments[mediaId] || [];
      if (!comments.length) { list.innerHTML = '<div class="comments-empty">No comments yet. Be the first! 💋</div>'; return; }
      list.innerHTML = comments.map(c => {
        const liked = myLikedCommentIds.has(c.id);
        return '<div class="comment-item">' +
          '<div class="comment-author">' + escapeHtml(c.author_name) + '</div>' +
          '<div class="comment-text">' + escapeHtml(c.comment) + '</div>' +
          '<button type="button" class="comment-like-btn' + (liked ? ' liked' : '') + '" data-comment-id="' + c.id + '" onclick="toggleCommentLike(this)">' +
            '<i class="fa-solid fa-heart"></i> <span class="comment-like-count">' + (commentLikeCounts[c.id] || 0) + '</span></button>' +
          '</div>';
      }).join('');
    }

    async function addComment(btn) {
      if (!state.currentUser) { showToast('Please sign in to comment.', 'error'); navigateToSection('signup-section'); return; }
      const card = btn.closest('.media-card');
      if (!card) return;
      const mediaId = btn.getAttribute('data-media-id');
      const input = card.querySelector('.comment-input');
      const text = (input.value || '').trim();
      if (!text) return showToast('Write something first.', 'error');
      try {
        const { error } = await supabaseClient.from('media_comments').insert({
          media_id: mediaId,
          user_id: state.currentUser.id,
          author_name: state.currentUser.username || state.currentUser.email.split('@')[0],
          comment: text
        });
        if (error) throw error;
        input.value = '';
        await loadMediaInteractions();
        renderComments(card, mediaId);
      } catch (e) {
        console.error('addComment error:', e);
        showToast(e.message || 'Could not post comment.', 'error');
      }
    }

    async function shareMedia(btn) {
      const card = btn.closest('.media-card');
      if (!card) return;
      const mediaId = card.getAttribute('data-media-id');
      const url = window.location.origin + window.location.pathname + '?media=' + mediaId;
      try {
        await navigator.clipboard.writeText(url);
        showToast('Link copied! Recipients sign up & unlock to view.');
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); ta.remove(); showToast('Link copied!'); }
        catch (_) { ta.remove(); showToast('Copy failed. Link: ' + url, 'error'); }
      }
    }

    function handleSharedMediaLink() {
      const params = new URLSearchParams(window.location.search);
      const mediaId = params.get('media');
      if (!mediaId) return;
      setTimeout(() => {
        const card = document.querySelector('.media-card[data-media-id="' + mediaId + '"]');
        if (!card) return;
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('shared-highlight');
        setTimeout(() => card.classList.remove('shared-highlight'), 4000);
        if (!state.currentUser) showToast('Sign in & unlock to view this shared image.');
      }, 600);
    }

    let authBusy = false;
    function setAuthBusy(busy) {
      authBusy = busy;
      document.querySelectorAll('.btn-auth-signin, .btn-auth-signup, .btn-auth-google').forEach(btn => { btn.disabled = busy; });
    }

    async function isEmailRegistered(email) {
      try {
        const { data, error } = await supabaseClient.rpc('is_email_registered', { p_email: email });
        if (error) return null;
        return !!data;
      } catch (_) { return null; }
    }

    async function handleUserSignIn() {
      if (authBusy) return;
      const email = document.getElementById('signup-email').value.trim();
      const password = document.getElementById('signup-pass').value;
      if (!email || !password) return showToast('Please enter your email and password.', 'error');
      if (!document.getElementById('captcha-check').checked) return showToast('Please check "Verify you are human"', 'error');
      setAuthBusy(true);
      try {
        const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
        if (error) {
          const msg = (error.message || '').toLowerCase();
          if (msg.includes('not confirmed')) return showToast('Your email is not confirmed yet. Check your inbox for the confirmation link, then sign in.', 'error');
          return showToast('Email or password is not correct.', 'error');
        }
        try {
          await loadCloudProfile(data.user); applyUserSessionUI(); await loadCloudMedia(); await loadMediaInteractions();
          navigateToSection('home-section'); showToast(`Welcome back, ${state.currentUser.username}!`);
        } catch (err) { showToast('Your profile could not be loaded.', 'error'); }
      } finally {
        setAuthBusy(false);
      }
    }

    async function handleUserSignUp() {
      if (authBusy) return;
      const email = document.getElementById('signup-email').value.trim();
      const password = document.getElementById('signup-pass').value;
      if (!email || !password) return showToast('Please enter your email and password.', 'error');
      if (!document.getElementById('captcha-check').checked) return showToast('Please check "Verify you are human"', 'error');
      setAuthBusy(true);
      try {
        const registered = await isEmailRegistered(email);
        if (registered === true) return showToast('This email is already registered. Please sign in instead.', 'error');
        const { data, error } = await supabaseClient.auth.signUp({
          email, password, options: { data: { username: email.split('@')[0] } }
        });
        if (error) {
          const msg = (error.message || '').toLowerCase();
          if (msg.includes('already registered')) return showToast('This email is already registered. Please sign in instead.', 'error');
          return showToast(error.message, 'error');
        }
        if (!data.session) return showToast('Account created. Check your email to confirm it, then sign in.');
        await loadCloudProfile(data.user); applyUserSessionUI(); await loadCloudMedia(); await loadMediaInteractions();
        navigateToSection('home-section'); showToast('Account created successfully!');
      } finally {
        setAuthBusy(false);
      }
    }

    async function handleGoogleSignIn() {
      if (authBusy) return;
      setAuthBusy(true);
      try {
        const { error } = await supabaseClient.auth.signInWithOAuth({
          provider: 'google',
          options: { redirectTo: window.location.origin }
        });
        if (error) showToast(error.message || 'Could not start Google sign-in.', 'error');
      } finally {
        setAuthBusy(false);
      }
    }

    function togglePasswordVisibility() {
      const input = document.getElementById('signup-pass');
      const icon = document.getElementById('password-toggle-icon');
      if (!input || !icon) return;
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      icon.classList.toggle('fa-eye', !show);
      icon.classList.toggle('fa-eye-slash', show);
    }

    async function handleDeleteAccount() {
      if (!state.currentUser) return showToast('You are not signed in.', 'error');
      const confirmed = confirm('This will permanently delete your account, credits, and all data. Are you sure?');
      if (!confirmed) return;
      const btn = document.getElementById('delete-account-btn');
      if (btn) { btn.disabled = true; btn.style.opacity = '0.6'; }
      try {
        const { error } = await supabaseClient.rpc('delete_own_account');
        if (error) throw new Error(error.message);
        await supabaseClient.auth.signOut();
        state.currentUser = null;
        localStorage.removeItem('kavya_session_user');
        localStorage.removeItem('kavya_unlocked');
        document.getElementById('main-header').style.display = 'none';
        closeSidebar();
        showToast('Your account has been deleted.');
        navigateToSection('signup-section');
      } catch (err) {
        console.error('Delete account error:', err);
        showToast(err.message || 'Could not delete your account. Please try again.', 'error');
      } finally {
        if (btn) { btn.disabled = false; btn.style.opacity = '1'; }
      }
    }

    async function handleSignOut() {
      await supabaseClient.auth.signOut();
      state.currentUser = null; localStorage.removeItem('kavya_session_user');
      document.getElementById('main-header').style.display = 'none'; closeSidebar(); navigateToSection('signup-section');
    }

    window.addEventListener('DOMContentLoaded', async () => {
      const { data: { session } } = await supabaseClient.auth.getSession();
      if (session) {
        try { await loadCloudProfile(session.user); applyUserSessionUI(); navigateToSection('home-section', false); }
        catch (_) { await supabaseClient.auth.signOut(); }
      }
      await loadCloudMedia();
      await loadMediaInteractions();
      handleSharedMediaLink();
      supabaseClient.channel('public-media')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'media' }, loadCloudMedia)
        .subscribe();
      supabaseClient.channel('public-interactions')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'media_likes' }, () => loadMediaInteractions())
        .on('postgres_changes', { event: '*', schema: 'public', table: 'media_comments' }, () => loadMediaInteractions())
        .subscribe();
    });

    function initDripCanvases() {
      document.querySelectorAll('.drip-canvas').forEach(function (canvas) {
        var parent = canvas.parentElement;
        var dpr = window.devicePixelRatio || 1;
        function resize() {
          var r = parent.getBoundingClientRect();
          canvas.width = Math.max(1, Math.round(r.width * dpr));
          canvas.height = Math.max(1, Math.round(r.height * dpr));
          canvas.style.width = r.width + 'px';
          canvas.style.height = r.height + 'px';
        }
        resize();
        window.addEventListener('resize', resize);
        var ctx = canvas.getContext('2d');
        var isRed = parent.classList.contains('btn-red-sub');
        var color = isRed ? '255,0,85' : '0,255,136';
        var drops = [];
        function spawn() {
          drops.push({ x: Math.random(), y: -5, v: 2 + Math.random() * 3, len: 8 + Math.random() * 18, w: 2 + Math.random() * 2 });
        }
        spawn(); spawn(); spawn();
        (function frame() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          if (Math.random() < 0.3) spawn();
          for (var i = 0; i < drops.length; i++) {
            var d = drops[i];
            d.y += d.v;
            var a = Math.max(0, 1 - d.y / canvas.height);
            ctx.beginPath();
            ctx.strokeStyle = 'rgba(' + color + ',' + a.toFixed(2) + ')';
            ctx.lineWidth = d.w;
            ctx.lineCap = 'round';
            ctx.moveTo(d.x * canvas.width, d.y);
            ctx.lineTo(d.x * canvas.width, Math.min(d.y + d.len, canvas.height));
            ctx.stroke();
          }
          drops = drops.filter(function (d) { return d.y < canvas.height; });
          requestAnimationFrame(frame);
        })();
      });
    }
    initDripCanvases();
  </script>
</body>
</html>

              <input type="text" id="phone-input-vip" placeholder="Enter 10‑digit mobile number" style="padding: 14px; border-radius: 12px; border: 1px solid var(--neon-red); background: rgba(255, 0, 85, 0.05); color: #fff; width: 100%; text-align: center; font-size: 1rem; margin-bottom: 12px; box-shadow: 0 0 15px var(--neon-red-glow);" />
            </div>
<button class="tier-action-btn btn-red-sub" onclick="buySubscription('vip_179')">
              <span class="btn-text">CLAIM FOR ₹179</span>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kavya VIP - Neon Experience</title>
  
  <!-- PWA Meta -->
  <meta name="theme-color" content="#07080c">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="manifest" href="manifest.json">
  <link rel="icon" type="image/jpeg" href="assets/person.jpeg">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;900&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    :root {
      --bg-dark: #07080c;
      --bg-card: rgba(18, 20, 29, 0.7);
      --bg-glass: rgba(255, 255, 255, 0.04);
      --border-glass: rgba(255, 255, 255, 0.08);
      
      --neon-green: #00ff88;
      --neon-green-glow: rgba(0, 255, 136, 0.4);
      --neon-red: #ff0055;
      --neon-red-glow: rgba(255, 0, 85, 0.45);
      --neon-cyan: #00f0ff;
      --neon-cyan-glow: rgba(0, 240, 255, 0.35);
      --neon-gray: #8b9bb4;
      --neon-gray-glow: rgba(139, 155, 180, 0.2);
      
      --text-main: #f0f4f8;
      --text-muted: #8e9bb0;
      
      --radius-lg: 20px;
      --radius-md: 12px;
      --transition-fast: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* Ambient Canvas */
    #ambient-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.6;
    }

    /* Top Navigation Header */
    header.main-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 70px;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(7, 8, 12, 0.85);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-glass);
      z-index: 100;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .menu-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-glass);
      color: var(--text-main);
      font-size: 1.2rem;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition-fast);
    }

    .menu-btn:hover {
      border-color: var(--neon-cyan);
      box-shadow: 0 0 12px var(--neon-cyan-glow);
      color: var(--neon-cyan);
    }

    /* Logo Clickable to Home */
    .logo-brand {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: 1px;
      background: linear-gradient(135deg, #ffffff 0%, var(--neon-cyan) 50%, var(--neon-red) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: var(--transition-fast);
    }

    .logo-brand:hover {
      opacity: 0.9;
      transform: scale(1.02);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .credits-badge {
      background: rgba(0, 255, 136, 0.08);
      border: 1px solid var(--neon-green-glow);
      padding: 8px 16px;
      border-radius: 30px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--neon-green);
      cursor: pointer;
      transition: var(--transition-fast);
    }

    .credits-badge:hover {
      background: rgba(0, 255, 136, 0.18);
      box-shadow: 0 0 16px var(--neon-green-glow);
      transform: translateY(-1px);
    }

    .profile-avatar-btn {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 2px solid var(--neon-red);
      overflow: hidden;
      cursor: pointer;
      box-shadow: 0 0 12px var(--neon-red-glow);
      transition: var(--transition-fast);
    }

    .profile-avatar-btn:hover {
      transform: scale(1.08);
      border-color: var(--neon-cyan);
      box-shadow: 0 0 18px var(--neon-cyan-glow);
    }

    .profile-avatar-btn img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Sidebar Overlay & Drawer */
    .sidebar-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 200;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .sidebar-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .sidebar-drawer {
      position: fixed;
      top: 0;
      left: -300px;
      width: 290px;
      height: 100%;
      background: rgba(12, 14, 22, 0.96);
      border-right: 1px solid var(--border-glass);
      backdrop-filter: blur(20px);
      z-index: 201;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 24px 16px;
      transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sidebar-overlay.active .sidebar-drawer {
      left: 0;
    }

    .drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border-glass);
      margin-bottom: 20px;
    }

    .drawer-close-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 1.3rem;
      cursor: pointer;
    }

    .drawer-close-btn:hover {
      color: var(--neon-red);
    }

    .nav-links-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 18px;
      border-radius: 12px;
      color: var(--text-muted);
      font-weight: 500;
      cursor: pointer;
      transition: var(--transition-fast);
    }

    .nav-item:hover, .nav-item.active {
      background: rgba(0, 240, 255, 0.08);
      color: var(--neon-cyan);
      border-left: 3px solid var(--neon-cyan);
    }

    .nav-item i {
      font-size: 1.2rem;
      width: 24px;
    }

    .drawer-footer {
      border-top: 1px solid var(--border-glass);
      padding-top: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .drawer-profile-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px;
      border-radius: 12px;
      background: var(--bg-card);
      cursor: pointer;
      transition: var(--transition-fast);
    }

    .btn-signout-drawer {
      width: 100%;
      background: rgba(255, 0, 85, 0.1);
      border: 1px solid var(--neon-red);
      color: var(--neon-red);
      padding: 12px;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: var(--transition-fast);
    }

    .btn-signout-drawer:hover {
      background: var(--neon-red);
      color: #fff;
      box-shadow: 0 0 15px var(--neon-red-glow);
    }

    /* Main View Container */
    main.view-container {
      position: relative;
      z-index: 1;
      padding-top: 90px;
      padding-bottom: 40px;
      min-height: 100vh;
      max-width: 1280px;
      margin: 0 auto;
      padding-left: 20px;
      padding-right: 20px;
    }

    .page-section {
      display: none;
      animation: fadeIn 0.4s ease forwards;
    }

    .page-section.active {
      display: block;
    }

    .legal-card {
      max-width: 860px;
      margin: 0 auto;
      padding: 32px;
      border: 1px solid var(--border-glass);
      border-radius: var(--radius-lg);
      background: var(--bg-card);
      line-height: 1.7;
      color: var(--text-muted);
    }

    .legal-card h1, .legal-card h2 { color: var(--text-main); margin-bottom: 14px; }
    .legal-card h2 { margin-top: 26px; font-size: 1.15rem; }
    .legal-card p, .legal-card li { margin-bottom: 12px; }
    .legal-card a { color: var(--neon-cyan); }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ---------------------------------------------------- */
    /* PAGE 1: SIGNUP / SIGNIN WITH SEPARATE 2 BUTTONS      */
    /* ---------------------------------------------------- */
    .signup-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 130px);
      perspective: 1000px;
    }

    .signup-card-3d {
      width: 100%;
      max-width: 480px;
      background: rgba(14, 16, 26, 0.85);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 240, 255, 0.25);
      border-radius: 24px;
      padding: 40px 32px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(0, 240, 255, 0.15);
      transform-style: preserve-3d;
      transition: transform 0.1s ease-out, box-shadow 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .person-hero-frame {
      width: 120px;
      height: 120px;
      margin: 0 auto 16px;
      border-radius: 50%;
      border: 3px solid var(--neon-red);
      box-shadow: 0 0 25px var(--neon-red-glow);
      overflow: hidden;
      transform: translateZ(30px);
    }

    .person-hero-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .signup-title {
      text-align: center;
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 6px;
      background: linear-gradient(135deg, #fff, var(--neon-green));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      transform: translateZ(20px);
    }

    .signup-subtitle {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 24px;
      transform: translateZ(15px);
    }

    .form-group {
      margin-bottom: 18px;
      transform: translateZ(15px);
    }

    .form-label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-input {
      width: 100%;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-glass);
      border-radius: 12px;
      padding: 14px 16px;
      color: #fff;
      font-size: 1rem;
      outline: none;
      transition: var(--transition-fast);
    }

    .form-input:focus {
      border-color: var(--neon-cyan);
      box-shadow: 0 0 15px var(--neon-cyan-glow);
      background: rgba(0, 240, 255, 0.03);
    }

    .password-wrap {
      position: relative;
    }

    .password-wrap .form-input {
      padding-right: 50px;
    }

    .password-toggle-btn {
      position: absolute;
      top: 50%;
      right: 8px;
      transform: translateY(-50%);
      width: 38px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.05rem;
      cursor: pointer;
      border-radius: 10px;
      transition: var(--transition-fast);
    }

    .password-toggle-btn:hover {
      color: var(--neon-cyan);
      text-shadow: 0 0 8px var(--neon-cyan-glow);
    }

    .captcha-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px dashed rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      cursor: pointer;
      transform: translateZ(15px);
    }

    .captcha-checkbox {
      width: 20px;
      height: 20px;
      accent-color: var(--neon-green);
      cursor: pointer;
    }

    /* Requirement 1: Separate SIGN IN and SIGN UP buttons */
    .dual-auth-buttons {
      display: flex;
      gap: 14px;
      transform: translateZ(25px);
    }

    .btn-auth-signin {
      flex: 1;
      padding: 16px;
      background: linear-gradient(135deg, var(--neon-green), #00b359);
      border: none;
      border-radius: 14px;
      color: #000;
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      cursor: pointer;
      box-shadow: 0 0 20px var(--neon-green-glow);
      transition: var(--transition-fast);
    }

    .btn-auth-signin:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 30px var(--neon-green-glow);
    }

    .btn-auth-signup {
      flex: 1;
      padding: 16px;
      background: linear-gradient(135deg, var(--neon-red), #d60047);
      border: none;
      border-radius: 14px;
      color: #fff;
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      cursor: pointer;
      box-shadow: 0 0 20px var(--neon-red-glow);
      transition: var(--transition-fast);
    }

    .btn-auth-signup:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 30px var(--neon-red-glow);
    }

    .auth-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 16px 0 12px;
      color: var(--text-muted);
      font-size: 0.85rem;
      letter-spacing: 1px;
      transform: translateZ(25px);
    }
    .auth-divider::before, .auth-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-glass);
    }
    .btn-auth-google {
      width: 100%;
      padding: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-glass);
      border-radius: 14px;
      color: var(--text-main);
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition-fast);
      transform: translateZ(25px);
    }
    .btn-auth-google:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--neon-cyan);
      transform: translateY(-2px);
    }
    .btn-auth-google:disabled, .btn-auth-signin:disabled, .btn-auth-signup:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
    }

    /* ---------------------------------------------------- */
    /* DASHBOARD & HERO SECTION                            */
    /* ---------------------------------------------------- */
    .dashboard-hero {
      position: relative;
      border-radius: 28px;
      background: linear-gradient(135deg, rgba(16, 18, 28, 0.9), rgba(10, 11, 17, 0.95));
      border: 1px solid var(--border-glass);
      overflow: hidden;
      padding: 40px 30px;
      margin-bottom: 36px;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 30px;
      align-items: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    @media (max-width: 900px) {
      .dashboard-hero {
        grid-template-columns: 1fr;
      }
    }

    .hero-content-left h1 {
      font-size: 2.5rem;
      font-weight: 900;
      line-height: 1.2;
      margin-bottom: 14px;
      background: linear-gradient(135deg, #ffffff, var(--neon-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-content-left p {
      color: var(--text-muted);
      font-size: 1.05rem;
      margin-bottom: 30px;
      max-width: 540px;
      line-height: 1.6;
    }

    .main-action-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .btn-neon-green {
      flex: 1;
      min-width: 220px;
      background: rgba(0, 255, 136, 0.08);
      border: 2px solid var(--neon-green);
      color: var(--neon-green);
      padding: 18px 24px;
      border-radius: 16px;
      font-size: 1.15rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      box-shadow: 0 0 20px var(--neon-green-glow);
      transition: var(--transition-fast);
      text-transform: uppercase;
    }

    .btn-neon-green:hover {
      background: var(--neon-green);
      color: #000;
      box-shadow: 0 0 35px var(--neon-green-glow);
      transform: translateY(-3px);
    }

    .btn-neon-red {
      flex: 1;
      min-width: 220px;
      background: rgba(255, 0, 85, 0.08);
      border: 2px solid var(--neon-red);
      color: var(--neon-red);
      padding: 18px 24px;
      border-radius: 16px;
      font-size: 1.15rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      box-shadow: 0 0 20px var(--neon-red-glow);
      transition: var(--transition-fast);
      text-transform: uppercase;
    }

    .btn-neon-red:hover {
      background: var(--neon-red);
      color: #fff;
      box-shadow: 0 0 35px var(--neon-red-glow);
      transform: translateY(-3px);
    }

    .hero-person-preview {
      position: relative;
      height: 320px;
      border-radius: 20px;
      overflow: hidden;
      border: 2px solid var(--neon-cyan-glow);
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.2);
    }

    .hero-person-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-person-preview .badge-tag {
      position: absolute;
      bottom: 14px;
      left: 14px;
      right: 14px;
      background: rgba(10, 12, 20, 0.85);
      backdrop-filter: blur(10px);
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 0.85rem;
      border: 1px solid var(--border-glass);
      color: var(--neon-green);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Section Headers */
    .section-title-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    .section-title-bar h2 {
      font-size: 1.6rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .media-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 24px;
    }

    .media-card {
      background: var(--bg-card);
      border: 1px solid var(--border-glass);
      border-radius: 20px;
      overflow: hidden;
      transition: var(--transition-fast);
      position: relative;
    }

    .media-card:hover {
      border-color: var(--neon-red-glow);
      box-shadow: 0 10px 30px rgba(255, 0, 85, 0.2);
      transform: translateY(-4px);
    }

    .media-thumb {
      height: 320px;
      position: relative;
      overflow: hidden;
    }

    .media-thumb img, .media-thumb video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .media-card:hover .media-thumb img {
      transform: scale(1.06);
    }

    .media-overlay-lock {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(10, 12, 18, 0.6);
      backdrop-filter: blur(12px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      opacity: 1;
      transition: var(--transition-fast);
    }

    .media-card.unlocked .media-overlay-lock {
      display: none;
    }

    .lock-icon-neon {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: rgba(255, 0, 85, 0.15);
      border: 2px solid var(--neon-red);
      color: var(--neon-red);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      box-shadow: 0 0 20px var(--neon-red-glow);
    }

    .unlock-btn {
      background: var(--neon-red);
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 20px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      box-shadow: 0 0 15px var(--neon-red-glow);
      transition: var(--transition-fast);
    }

    .unlock-btn:hover {
      transform: scale(1.05);
    }

    .media-info {
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .media-title {
      font-weight: 600;
      font-size: 1.05rem;
    }

    .media-cost {
      color: var(--neon-green);
      font-weight: 700;
      font-size: 0.9rem;
    }

    /* Interactive Chat */
    .chat-container {
      background: var(--bg-card);
      border: 1px solid var(--border-glass);
      border-radius: 24px;
      height: 600px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .chat-header {
      padding: 16px 24px;
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid var(--border-glass);
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .chat-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid var(--neon-green);
      object-fit: cover;
    }

    .chat-messages-area {
      flex: 1;
      padding: 24px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .msg-bubble {
      max-width: 70%;
      padding: 14px 18px;
      border-radius: 18px;
      font-size: 0.98rem;
      line-height: 1.5;
    }

    .msg-bubble.bot {
      background: rgba(0, 240, 255, 0.08);
      border: 1px solid rgba(0, 240, 255, 0.2);
      color: #fff;
      align-self: flex-start;
      border-top-left-radius: 4px;
    }

    .msg-bubble.user {
      background: linear-gradient(135deg, var(--neon-red), #b5003c);
      color: #fff;
      align-self: flex-end;
      border-top-right-radius: 4px;
      box-shadow: 0 4px 15px var(--neon-red-glow);
    }

    .chat-input-bar {
      padding: 16px 24px;
      border-top: 1px solid var(--border-glass);
      display: flex;
      gap: 12px;
      background: rgba(10, 12, 18, 0.8);
    }

    .chat-input-field {
      flex: 1;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-glass);
      border-radius: 14px;
      padding: 12px 18px;
      color: #fff;
      outline: none;
    }

    .chat-send-btn {
      background: var(--neon-green);
      color: #000;
      border: none;
      width: 48px;
      height: 48px;
      border-radius: 14px;
      font-size: 1.1rem;
      cursor: pointer;
      box-shadow: 0 0 15px var(--neon-green-glow);
    }

    /* PROFILE PAGE WITH DEFAULT "Normal User" TIER STATUS */
    .profile-card {
      background: var(--bg-card);
      border: 1px solid var(--border-glass);
      border-radius: 28px;
      padding: 40px;
      max-width: 680px;
      margin: 0 auto;
      text-align: center;
      position: relative;
    }

    .profile-dp-container {
      position: relative;
      width: 140px;
      height: 140px;
      margin: 0 auto 24px;
    }

    .profile-dp-img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid var(--neon-red);
      box-shadow: 0 0 25px var(--neon-red-glow);
    }

    .edit-dp-badge {
      position: absolute;
      bottom: 4px;
      right: 4px;
      width: 40px;
      height: 40px;
      background: var(--neon-cyan);
      color: #000;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 0 12px var(--neon-cyan-glow);
    }

    .profile-username-input {
      font-size: 1.6rem;
      font-weight: 700;
      background: transparent;
      border: none;
      border-bottom: 2px dashed rgba(255, 255, 255, 0.2);
      color: #fff;
      text-align: center;
      outline: none;
      padding: 6px;
      margin-bottom: 12px;
      width: 260px;
    }

    .credits-stat-box {
      background: rgba(0, 255, 136, 0.06);
      border: 1px solid var(--neon-green-glow);
      border-radius: 20px;
      padding: 20px 30px;
      margin: 24px 0;
      display: flex;
      align-items: center;
      justify-content: space-around;
    }

    .stat-item h3 {
      font-size: 1.8rem;
      color: var(--neon-green);
      font-weight: 900;
    }

    .stat-item p {
      color: var(--text-muted);
      font-size: 0.85rem;
      text-transform: uppercase;
      margin-top: 4px;
    }

    /* SUBSCRIPTION TIERS FROM SPEC */
    .sub-title-area {
      text-align: center;
      margin-bottom: 44px;
    }

    .sub-title-area h1 {
      font-size: 2.8rem;
      font-weight: 900;
      margin-bottom: 12px;
      background: linear-gradient(135deg, #fff, var(--neon-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .sub-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
    }

    .sub-card.tier-free {
      background: rgba(139, 155, 180, 0.08);
      border: 2px solid var(--neon-gray-glow);
      border-radius: 24px;
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .btn-neon-gray {
      background: rgba(139, 155, 180, 0.15);
      color: var(--neon-gray);
      border: 1px solid var(--neon-gray);
      padding: 14px;
      border-radius: 14px;
      font-size: 1.2rem;
      font-weight: 800;
      width: 100%;
      text-align: center;
      margin-bottom: 24px;
    }

    .sub-card.tier-green {
      background: rgba(0, 255, 136, 0.08);
      border: 2px solid var(--neon-green);
      border-radius: 24px;
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 0 20px var(--neon-green-glow);
    }

    .price-display-green {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    .price-old {
      text-decoration: line-through;
      color: var(--text-muted);
      font-size: 1.4rem;
    }

    .price-new-green {
      color: var(--neon-green);
      font-size: 2.2rem;
      font-weight: 900;
    }

    .sub-card.tier-red {
      background: rgba(255, 0, 85, 0.08);
      border: 2px solid var(--neon-red);
      border-radius: 24px;
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 0 20px var(--neon-red-glow);
    }

    .price-display-red {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    .bullet-points-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 20px;
    }

    .bullet-points-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--text-main);
    }

    .tier-action-btn {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
      border: none;
      margin-top: 28px;
      transition: var(--transition-fast);
    }

    .btn-green-sub {
      background: var(--neon-green);
      color: #000;
      box-shadow: 0 0 15px var(--neon-green-glow);
    }

    .btn-red-sub {
      background: var(--neon-red);
      color: #fff;
      box-shadow: 0 0 15px var(--neon-red-glow);
    }

    /* Lightbox Modal */
    .modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(14px);
      z-index: 300;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-backdrop.active {
      display: flex;
    }

    .modal-content-box {
      max-width: 600px;
      width: 100%;
      background: var(--bg-card);
      border: 1px solid var(--neon-cyan);
      border-radius: 24px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 0 40px var(--neon-cyan-glow);
    }

    .modal-img {
      width: 100%;
      max-height: 500px;
      object-fit: contain;
    }

    .modal-close-icon {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    /* Toast */
    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 400;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .toast-msg {
      background: rgba(12, 14, 22, 0.95);
      border: 1px solid var(--neon-cyan);
      color: #fff;
      padding: 14px 20px;
      border-radius: 14px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
      display: flex;
      align-items: center;
      gap: 12px;
      animation: slideInRight 0.3s ease forwards;
    }
  </style>
<style>
    .tier-action-btn { position: relative; overflow: hidden; }
    .anim-lips {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 40px;
      height: 20px;
      background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 50"><path d="M10 25 Q 25 0, 50 25 T 90 25" fill="none" stroke="%23ff0055" stroke-width="5"/><path d="M10 25 Q 25 50, 50 25 T 90 25" fill="%23ff0055"/></svg>');
      background-size: contain;
      background-repeat: no-repeat;
      opacity: 0;
      animation: lip-bite 1s ease-in-out forwards;
    }
    @keyframes lip-bite {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
      50% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
      100% { opacity: 0; transform: translate(-50%, -150%) scale(0.5); }
    }
    .anim-drip {
      position: absolute;
      top: -30px;
      left: 50%;
      width: 4px;
      height: 40px;
      background: white;
      border-radius: 2px;
      animation: drip 1.2s ease-out forwards;
      opacity: 0;
    }
    @keyframes drip {
      0% { top: -30px; opacity: 1; }
      100% { top: 100%; opacity: 0; }
    }
  </style>
<style>
/* Inlined from animations.css */
/* Lip Biting Animation */
.price-new-green {
  position: relative;
  display: inline-block;
}

.lips-container {
  position: absolute;
  left: 60%;
  top: -10px;
  width: 50px;
  height: 25px;
  transform-origin: center;
  opacity: 0;
  animation: peek-and-bite 4.5s ease-in-out infinite 1s;
}

.lips-svg {
  width: 100%;
  height: 100%;
}

#lower-lip {
  transform-origin: center;
  animation: lip-bite-action 4.5s ease-in-out infinite 1s;
}

@keyframes peek-and-bite {
  0%, 20%, 90%, 100% { transform: translateX(25px) scale(0.7); opacity: 0; }
  30%, 80% { transform: translateX(0) scale(1); opacity: 1; }
}

@keyframes lip-bite-action {
  0%, 50%, 65%, 100% { transform: scaleY(1); }
  58% { transform: scaleY(0.3); }
}

/* Dripping Liquid Animation */
.price-new-red, .tier-action-btn {
  position: relative;
  overflow: hidden;
}

.drip-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

</style>
  <style>
    /* Likes / Comments / Share */
    .media-actions {
      display: flex;
      gap: 10px;
      padding: 10px 14px;
    }
    .media-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-glass);
      color: var(--text-muted);
      padding: 8px 12px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 0.9rem;
      transition: var(--transition-fast);
    }
    .media-action-btn:hover {
      color: var(--neon-cyan);
      border-color: var(--neon-cyan);
    }
    .media-action-btn.liked {
      color: var(--neon-red);
      border-color: var(--neon-red);
      background: rgba(255, 0, 85, 0.12);
    }
    .media-comments-box {
      display: none;
      padding: 0 14px 14px;
    }
    .comments-list {
      max-height: 160px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 10px;
    }
    .comments-empty {
      color: var(--text-muted);
      font-size: 0.85rem;
    }
    .comment-item {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-glass);
      border-radius: 12px;
      padding: 8px 12px;
    }
    .comment-author {
      color: var(--neon-cyan);
      font-weight: 700;
      font-size: 0.8rem;
    }
    .comment-text {
      color: var(--text-main);
      font-size: 0.9rem;
      margin: 4px 0;
      word-break: break-word;
    }
    .comment-like-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.8rem;
      padding: 2px 6px;
      border-radius: 10px;
    }
    .comment-like-btn.liked {
      color: var(--neon-red);
    }
    .comment-input-row {
      display: flex;
      gap: 8px;
    }
    .comment-input {
      flex: 1;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-glass);
      border-radius: 20px;
      padding: 10px 14px;
      color: #fff;
      font-size: 0.9rem;
      outline: none;
    }
    .comment-input:focus {
      border-color: var(--neon-cyan);
    }
    .comment-submit-btn {
      background: linear-gradient(135deg, var(--neon-red), #d60047);
      color: #fff;
      border: none;
      border-radius: 20px;
      padding: 0 18px;
      font-weight: 700;
      cursor: pointer;
    }
    .kiss-float {
      position: fixed;
      z-index: 9999;
      pointer-events: none;
      font-size: 1.6rem;
      animation: kissUp 1.4s ease-out forwards;
    }
    @keyframes kissUp {
      0% { opacity: 1; transform: translateY(0) scale(0.6); }
      100% { opacity: 0; transform: translateY(-130px) scale(1.4) rotate(15deg); }
    }
    .shared-highlight {
      box-shadow: 0 0 0 3px var(--neon-cyan), 0 0 30px var(--neon-cyan-glow);
    }
  </style>
</head>
<body>

  <canvas id="ambient-canvas"></canvas>

  <!-- Top Main Header -->
  <header class="main-header" id="main-header">
    <div class="nav-left">
      <button class="menu-btn" id="open-menu-btn" aria-label="Toggle Menu">
        <i class="fa-solid fa-bars"></i>
      </button>
      <!-- Clickable Logo Navigates to Home -->
      <div class="logo-brand" id="logo-brand-btn" onclick="navigateToSection('home-section')">
        <i class="fa-solid fa-bolt" style="color: var(--neon-green);"></i> KAVYA <span style="font-size: 0.75rem; color: var(--neon-red); padding: 2px 6px; border: 1px solid var(--neon-red); border-radius: 6px; margin-left: 4px;">VIP</span>
      </div>
    </div>
    <div class="nav-right">
      <div class="credits-badge" id="nav-credits-btn">
        <i class="fa-solid fa-coins"></i> <span id="credits-amount-display">21</span> Credits
      </div>
      <div class="profile-avatar-btn" id="nav-profile-btn" title="View Profile">
        <img id="nav-avatar-img" src="assets/person.jpeg" alt="User Profile">
      </div>
    </div>
  </header>

  <!-- Sidebar Overlay & Drawer -->
  <div class="sidebar-overlay" id="sidebar-overlay">
    <div class="sidebar-drawer">
      <div>
        <!-- Drawer Header Requirement 3: Changed title to logo "KAVYA [VIP]" -->
        <div class="drawer-header">
          <div class="logo-brand" onclick="navigateToSection('home-section')">
            <i class="fa-solid fa-bolt" style="color: var(--neon-green);"></i> KAVYA <span style="font-size: 0.75rem; color: var(--neon-red); padding: 2px 6px; border: 1px solid var(--neon-red); border-radius: 6px; margin-left: 4px;">VIP</span>
          </div>
          <button class="drawer-close-btn" id="close-menu-btn">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <ul class="nav-links-list">
          <li class="nav-item active" data-target="home-section">
            <i class="fa-solid fa-house"></i> Home
          </li>
          <li class="nav-item" data-target="chat-section">
            <i class="fa-solid fa-comments"></i> Chat
          </li>
          <li class="nav-item" data-target="images-section">
            <i class="fa-solid fa-images"></i> Images
          </li>
          <li class="nav-item" data-target="videos-section">
            <i class="fa-solid fa-video"></i> Videos
          </li>
          <li class="nav-item" data-target="upgrade-section">
            <i class="fa-solid fa-rocket"></i> Upgrade
          </li>
          <li class="nav-item" data-target="about-section">
            <i class="fa-solid fa-circle-info"></i> About Us
          </li>
          <li class="nav-item" data-target="contact-section">
            <i class="fa-solid fa-envelope"></i> Contact Us
          </li>
          <li class="nav-item" data-target="privacy-section">
            <i class="fa-solid fa-shield-halved"></i> Privacy Policy
          </li>
          <li class="nav-item" data-target="terms-section">
            <i class="fa-solid fa-file-contract"></i> Terms & Conditions
          </li>
        </ul>
      </div>
      
      <div class="drawer-footer">
        <div class="drawer-profile-link" id="drawer-profile-btn">
          <img id="drawer-avatar-img" src="assets/person.jpeg" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;" alt="Profile">
          <div>
            <div style="font-weight: 700; font-size: 0.9rem;" id="drawer-username-display">User VIP</div>
            <div style="font-size: 0.75rem; color: var(--neon-green);" id="drawer-credits-display">⚡ 21 Credits</div>
          </div>
        </div>

        <button class="btn-signout-drawer" onclick="handleSignOut()">
          <i class="fa-solid fa-right-from-bracket"></i> Sign Out
        </button>
      </div>
    </div>
  </div>

  <!-- Main View Container -->
  <main class="view-container">

    <!-- PAGE 1: SIGNUP / SIGNIN WITH SEPARATE BUTTONS & CREDENTIAL VALIDATION -->
    <section id="signup-section" class="page-section active">
      <div class="signup-wrapper">
        <div class="signup-card-3d" id="signup-card-3d">
          <div class="person-hero-frame">
            <img src="assets/person.jpeg" alt="Kavya Rachana Neon Background">
          </div>
          <h2 class="signup-title">Welcome to Kavya VIP</h2>
          <p class="signup-subtitle">Sign in or create account to unlock neon content</p>
          
          <form id="signup-form" onsubmit="event.preventDefault()">
            <div class="form-group">
              <label class="form-label">Email Address</label>
              <input type="email" id="signup-email" class="form-input" placeholder="user@example.com" required>
            </div>
<div class="form-group">
              <label class="form-label">Password</label>
              <div class="password-wrap">
                <input type="password" id="signup-pass" class="form-input" placeholder="••••••••" required>
                <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility()" aria-label="Show password">
                  <i class="fa-solid fa-eye" id="password-toggle-icon"></i>
                </button>
              </div>
            </div>
            
            <div class="captcha-box" onclick="toggleCaptcha()">
              <input type="checkbox" id="captcha-check" class="captcha-checkbox">
              <span style="font-size: 0.9rem; color: var(--text-main);">Verify you are human <i class="fa-solid fa-shield-halved" style="color: var(--neon-cyan); margin-left: 6px;"></i></span>
            </div>

            <!-- Requirement 1: Two Separate Buttons for SIGN IN and SIGN UP -->
            <div class="dual-auth-buttons">
              <button type="button" class="btn-auth-signin" onclick="handleUserSignIn()">
                SIGN IN <i class="fa-solid fa-right-to-bracket" style="margin-left: 6px;"></i>
              </button>
              <button type="button" class="btn-auth-signup" onclick="handleUserSignUp()">
                SIGN UP <i class="fa-solid fa-user-plus" style="margin-left: 6px;"></i>
              </button>
            </div>

            <div class="auth-divider"><span>OR</span></div>
            <button type="button" class="btn-auth-google" onclick="handleGoogleSignIn()">
              <svg class="google-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
              Continue with Google
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- PAGE 2: MAIN DASHBOARD -->
    <section id="home-section" class="page-section">
      <div class="dashboard-hero">
        <div class="hero-content-left">
          <h1>EXCLUSIVE NEON WORLD</h1>
          <p>Connect with interactive AI messages, unlock exclusive hot pics, daily melons, and wet rain shower reels.</p>
          
          <div class="main-action-buttons">
            <button class="btn-neon-green" onclick="navigateToSection('chat-section')">
              <i class="fa-solid fa-message"></i> Chat with msg box
            </button>
            <button class="btn-neon-red" onclick="navigateToSection('images-section')">
              Pics & videos 💋
            </button>
          </div>
        </div>

        <div class="hero-person-preview">
          <img src="assets/person.jpeg" alt="Kavya VIP Person">
          <div class="badge-tag">
            <span><i class="fa-solid fa-circle" style="color: var(--neon-green); font-size: 0.6rem; margin-right: 6px;"></i> LIVE NOW</span>
            <!-- Requirement 4: Name updated to Kavya Rachana -->
            <span style="font-weight: 700;">KAVYA RACHANA</span>
          </div>
        </div>
      </div>

      <div class="section-title-bar">
        <h2><i class="fa-solid fa-fire" style="color: var(--neon-red);"></i> Trending Media</h2>
        <span style="color: var(--neon-cyan); cursor: pointer;" onclick="navigateToSection('images-section')">View All <i class="fa-solid fa-chevron-right"></i></span>
      </div>

      <div class="media-grid" id="home-media-grid"></div>
    </section>

    <!-- SECTION: CHAT WITH MSG BOX -->
    <section id="chat-section" class="page-section">
      <div class="section-title-bar">
        <h2><i class="fa-solid fa-comments" style="color: var(--neon-green);"></i> Chat with Msg Box</h2>
        <div style="font-size: 0.9rem; color: var(--neon-green);">⚡ 1 Credit per response</div>
      </div>

      <div class="chat-container">
        <div class="chat-header">
          <img src="assets/person.jpeg" class="chat-avatar" alt="Kavya">
          <div>
            <!-- Requirement 4: Name updated to Kavya Rachana -->
            <div style="font-weight: 700;">Kavya Rachana</div>
            <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
              <span style="width: 8px; height: 8px; background: var(--neon-green); border-radius: 50%; display: inline-block;"></span> Online & Active
            </div>
          </div>
        </div>

        <div class="chat-messages-area" id="chat-messages">
          <div class="msg-bubble bot">
            Hey there! Welcome to my private chat room 💋 What are you thinking about today?
          </div>
        </div>

        <div class="chat-input-bar">
          <input type="text" id="chat-input-msg" class="chat-input-field" placeholder="Type your message..." onkeypress="if(event.key==='Enter') sendChatMessage()">
          <button class="chat-send-btn" onclick="sendChatMessage()">
            <i class="fa-solid fa-paper-plane"></i>
          </button>
        </div>
      </div>

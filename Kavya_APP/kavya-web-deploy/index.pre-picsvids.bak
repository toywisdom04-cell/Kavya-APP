    <!-- SECTION: PICS GALLERY -->
    <section id="images-section" class="page-section">
      <div class="section-title-bar">
        <h2><i class="fa-solid fa-images" style="color: var(--neon-red);"></i> Exclusive Pics & Melons</h2>
      </div>
      <div class="media-grid" id="images-media-grid"></div>
    </section>

    <!-- SECTION: VIDEOS SHOWCASE -->
    <section id="videos-section" class="page-section">
      <div class="section-title-bar">
        <h2><i class="fa-solid fa-video" style="color: var(--neon-cyan);"></i> Under Shower Videos</h2>
      </div>

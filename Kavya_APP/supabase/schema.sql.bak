-- Run this once in Supabase Dashboard -> SQL Editor -> New query.
-- It creates the shared account, media and Storage foundation for both sites.

create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  email text unique not null,
  username text not null,
  role text not null default 'user' check (role in ('user', 'admin')),
  credits integer not null default 50 check (credits >= 0),
  tier_status text not null default 'Normal User',
  avatar_url text,
  created_at timestamptz not null default now()
);

create table if not exists public.media (
  id uuid primary key default gen_random_uuid(),
  title text not null check (char_length(title) between 1 and 160),
  media_type text not null check (media_type in ('image', 'video')),
  storage_path text not null unique,
  credit_cost integer not null check (credit_cost > 0),
  created_at timestamptz not null default now(),
  created_by uuid not null references public.profiles(id) on delete restrict
);

-- Cashfree orders are created only by server-side Edge Functions. Browser code
-- must never grant credits or mark an order paid.
create table if not exists public.payment_orders (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references public.profiles(id) on delete restrict,
  cashfree_order_id text not null unique,
  plan_id text not null check (plan_id in ('pro_50', 'vip_150', 'pro_99', 'vip_179')),
  amount_paise integer not null check (amount_paise in (5000, 15000, 9900, 17900)),
  credits_to_add integer not null check (credits_to_add in (200, 500, 400, 800, 100, 180)),
  tier_status text not null check (tier_status in ('Pro Member', 'VIP Member')),
  mobile text,
  status text not null default 'created' check (status in ('created', 'paid', 'failed', 'expired')),
  cashfree_payment_id text unique,
  created_at timestamptz not null default now(),
  paid_at timestamptz
);

create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer set search_path = public
as $$
begin
  insert into public.profiles (id, email, username)
  values (
    new.id,
    new.email,
    coalesce(nullif(new.raw_user_meta_data ->> 'username', ''), split_part(new.email, '@', 1))
  )
  on conflict (id) do nothing;
  return new;
end;
$$;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute procedure public.handle_new_user();

create or replace function public.is_admin()
returns boolean
language sql
stable
security definer set search_path = public
as $$
  select exists (select 1 from public.profiles where id = auth.uid() and role = 'admin');
$$;

alter table public.profiles enable row level security;
alter table public.media enable row level security;
alter table public.payment_orders enable row level security;

drop policy if exists "Users can read their own profile" on public.profiles;
create policy "Users can read their own profile"
  on public.profiles for select to authenticated
  using (id = auth.uid() or public.is_admin());

drop policy if exists "Anyone can read published media" on public.media;
create policy "Anyone can read published media"
  on public.media for select to anon, authenticated using (true);

drop policy if exists "Admins can publish media" on public.media;
create policy "Admins can publish media"
  on public.media for insert to authenticated
  with check (public.is_admin() and created_by = auth.uid());

drop policy if exists "Admins can delete media" on public.media;
create policy "Admins can delete media"
  on public.media for delete to authenticated using (public.is_admin());

insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values (
  'media', 'media', true, 52428800,
  array['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'video/mp4', 'video/webm']
)
on conflict (id) do update set public = true;

drop policy if exists "Public can view published media files" on storage.objects;
create policy "Public can view published media files"
  on storage.objects for select to public using (bucket_id = 'media');

drop policy if exists "Admins can upload media files" on storage.objects;
create policy "Admins can upload media files"
  on storage.objects for insert to authenticated
  with check (bucket_id = 'media' and public.is_admin());

drop policy if exists "Admins can delete media files" on storage.objects;
create policy "Admins can delete media files"
  on storage.objects for delete to authenticated
  using (bucket_id = 'media' and public.is_admin());

do $$
begin
  alter publication supabase_realtime add table public.media;
exception when duplicate_object then null;
end $$;

-- After creating your first account in the USER portal, run this once.
-- Replace the email before running. Never grant admin from browser code.
-- update public.profiles set role = 'admin' where email = 'your-admin-email@example.com';

drop policy if exists "Users can read their own payment orders" on public.payment_orders;
create policy "Users can read their own payment orders"
  on public.payment_orders for select to authenticated
  using (user_id = auth.uid() or public.is_admin());

-- Purchase snapshots are kept separately from the live profile so every successful
-- payment remains exportable even if the user later changes tier or balance.
create table if not exists public.buyer_records (
  id bigint generated by default as identity primary key, -- S.no
  user_id uuid references public.profiles(id) on delete set null,
  email text not null,
  mobile text,
  plan_id text not null,
  amount_paise integer,
  credits_purchased integer,
  cashfree_order_id text unique,
  cashfree_payment_id text unique,
  created_at timestamptz not null default now(),
  paid_at timestamptz
);

alter table public.buyer_records add column if not exists amount_paise integer;
alter table public.buyer_records add column if not exists credits_purchased integer;
alter table public.buyer_records add column if not exists cashfree_order_id text;
alter table public.buyer_records add column if not exists cashfree_payment_id text;
alter table public.buyer_records add column if not exists paid_at timestamptz;

-- Backfill fields that are derivable from the existing plan IDs. Historical phone,
-- payment IDs, and credit-use events cannot be reconstructed if they were not saved.
update public.buyer_records
set amount_paise = case plan_id
    when 'pro_50' then 5000
    when 'vip_150' then 15000
    when 'pro_99' then 9900
    when 'vip_179' then 17900
    else amount_paise
  end,
    credits_purchased = case plan_id
    when 'pro_50' then 200
    when 'vip_150' then 500
    when 'pro_99' then 100
    when 'vip_179' then 180
    else credits_purchased
  end
where amount_paise is null or credits_purchased is null;

create unique index if not exists buyer_records_cashfree_order_id_idx
  on public.buyer_records (cashfree_order_id)
  where cashfree_order_id is not null;
create unique index if not exists buyer_records_cashfree_payment_id_idx
  on public.buyer_records (cashfree_payment_id)
  where cashfree_payment_id is not null;

alter table public.buyer_records enable row level security;

drop policy if exists "Admins can access buyer records" on public.buyer_records;
create policy "Admins can access buyer records"
  on public.buyer_records for select to authenticated
  using (public.is_admin());

drop policy if exists "Service role can insert buyer records" on public.buyer_records;
create policy "Service role can insert buyer records"
  on public.buyer_records for insert to service_role with check (true);

-- Every credit change is recorded with a signed amount. Positive amounts are
-- purchases; negative amounts are usage or an administrator adjustment.
create table if not exists public.credit_transactions (
  id bigint generated by default as identity primary key,
  user_id uuid not null references public.profiles(id) on delete cascade,
  transaction_type text not null check (transaction_type in ('purchase', 'media_unlock', 'chat', 'adjustment')),
  amount integer not null check (amount <> 0),
  balance_after integer not null check (balance_after >= 0),
  reference_id text,
  description text,
  created_at timestamptz not null default now()
);

alter table public.credit_transactions enable row level security;

drop policy if exists "Users can read their own credit transactions" on public.credit_transactions;
create policy "Users can read their own credit transactions"
  on public.credit_transactions for select to authenticated
  using (user_id = auth.uid() or public.is_admin());

drop policy if exists "Service role can insert credit transactions" on public.credit_transactions;
create policy "Service role can insert credit transactions"
  on public.credit_transactions for insert to service_role with check (true);

-- Called from the verified Cashfree webhook. The status predicate makes credit
-- fulfilment idempotent when Cashfree retries a webhook.
create or replace function public.fulfill_cashfree_order(
  p_cashfree_order_id text,
  p_cashfree_payment_id text
)
returns boolean
language plpgsql
security definer set search_path = public
as $$
declare
  paid_order public.payment_orders;
  buyer_profile public.profiles;
begin
  update public.payment_orders
  set status = 'paid', cashfree_payment_id = p_cashfree_payment_id, paid_at = now()
  where cashfree_order_id = p_cashfree_order_id and status = 'created'
  returning * into paid_order;

  if not found then return false; end if;

  update public.profiles
  set credits = credits + paid_order.credits_to_add,
      tier_status = paid_order.tier_status
  where id = paid_order.user_id
  returning * into buyer_profile;

  insert into public.buyer_records (
    user_id, email, mobile, plan_id, amount_paise, credits_purchased,
    cashfree_order_id, cashfree_payment_id, paid_at
  )
  values (
    paid_order.user_id, buyer_profile.email, paid_order.mobile, paid_order.plan_id,
    paid_order.amount_paise, paid_order.credits_to_add, paid_order.cashfree_order_id,
    paid_order.cashfree_payment_id, paid_order.paid_at
  );

  insert into public.credit_transactions (
    user_id, transaction_type, amount, balance_after, reference_id, description
  )
  values (
    paid_order.user_id, 'purchase', paid_order.credits_to_add, buyer_profile.credits,
    paid_order.cashfree_order_id, concat('Cashfree ', paid_order.plan_id, ' purchase')
  );

  return true;
end;
$$;

revoke all on function public.fulfill_cashfree_order(text, text) from public;
grant execute on function public.fulfill_cashfree_order(text, text) to service_role;

create table if not exists public.user_media_unlocks (
  user_id uuid not null references public.profiles(id) on delete cascade,
  media_id uuid not null references public.media(id) on delete cascade,
  unlocked_at timestamptz not null default now(),
  primary key (user_id, media_id)
);

alter table public.user_media_unlocks enable row level security;

drop policy if exists "Users can read their own media unlocks" on public.user_media_unlocks;
create policy "Users can read their own media unlocks"
  on public.user_media_unlocks for select to authenticated
  using (user_id = auth.uid());

create or replace function public.unlock_media_for_current_user(p_media_id uuid)
returns json
language plpgsql
security definer set search_path = public
as $$
declare
  media_item public.media;
  current_user_id uuid := auth.uid();
  current_user_credits integer;
  new_credit_balance integer;
begin
  -- Step 1: Verify the media item exists and get its cost.
  select * into media_item from public.media where id = p_media_id;
  if not found then
    raise exception 'MEDIA_NOT_FOUND';
  end if;

  -- Step 2: Check if user has already unlocked this item.
  if exists (select 1 from public.user_media_unlocks where user_id = current_user_id and media_id = p_media_id) then
    return json_build_object('status', 'already_unlocked', 'media_id', p_media_id, 'credits_balance', (select credits from public.profiles where id = current_user_id));
  end if;

  -- Step 3: Get current user's credits and check if they have enough.
  select credits into current_user_credits from public.profiles where id = current_user_id;
  if current_user_credits < media_item.credit_cost then
    raise exception 'INSUFFICIENT_CREDITS';
  end if;

  -- Step 4: Atomically deduct credits.
  update public.profiles
  set credits = credits - media_item.credit_cost
  where id = current_user_id
  returning credits into new_credit_balance;

  -- Step 5: Record the unlock and its credit usage in the same transaction.
  insert into public.user_media_unlocks (user_id, media_id)
  values (current_user_id, p_media_id);
  insert into public.credit_transactions (
    user_id, transaction_type, amount, balance_after, reference_id, description
  )
  values (
    current_user_id, 'media_unlock', -media_item.credit_cost, new_credit_balance,
    p_media_id::text, concat('Unlocked ', media_item.title)
  );

  -- Step 6: Return success with the new balance.
  return json_build_object('status', 'unlocked', 'media_id', p_media_id, 'credits_balance', new_credit_balance);
exception
  when others then
    return json_build_object('status', 'error', 'message', SQLERRM);
end;
$$;

revoke all on function public.unlock_media_for_current_user(uuid) from public;
grant execute on function public.unlock_media_for_current_user(uuid) to authenticated;

create or replace function public.deduct_chat_credit()
returns boolean
language plpgsql
security definer set search_path = public
as $$
declare
  current_user_id uuid := auth.uid();
  current_user_credits integer;
  new_credit_balance integer;
begin
  select credits into current_user_credits from public.profiles where id = current_user_id;
  if current_user_credits is null or current_user_credits < 1 then
    return false;
  end if;

  update public.profiles
  set credits = credits - 1
  where id = current_user_id
  returning credits into new_credit_balance;

  insert into public.credit_transactions (
    user_id, transaction_type, amount, balance_after, description
  )
  values (
    current_user_id, 'chat', -1, new_credit_balance, 'Chat message credit'
  );

  return true;
end;
$$;

revoke all on function public.deduct_chat_credit() from public;
grant execute on function public.deduct_chat_credit() to authenticated;
